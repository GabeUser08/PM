Algoritmo "ex12"
Var
 idade:inteiro

Inicio
 escreva("idade: ")
 leia(idade)

 se (idade <= 12) entao
  escreva("crianca")
 senao
  se (idade <= 17) entao
   escreva("adolescente")
  senao
   se (idade <= 59) entao
    escreva("adulto")
   senao
    escreva("idoso")
   fimse
  fimse
 fimse

Fimalgoritmo